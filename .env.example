# Copy to .env and fill in real values. Loaded automatically by pydantic-settings.
# POLY_* env vars always override YAML.

# Async SQLAlchemy URL (asyncpg driver)
POLY_DATABASE_URL=postgresql+asyncpg://polycrawler:polycrawler@localhost:5432/poly_crawler

# Optional: same URL without POLY_ prefix (also accepted by alembic/env.py and db engine)
# DATABASE_URL=postgresql+asyncpg://polycrawler:polycrawler@localhost:5432/poly_crawler

# Polygon RPC (Alchemy / QuickNode / public)
# POLY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional production YAML overlay
# POLY_CONFIG=config/production.yaml
